<!doctype html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>OceanSafe Town Ad — $30/mo</title>
<meta name="description" content="Get your Kauaʻi business in front of visitors who open OceanSafe before the beach. A Town-tab listing, a printable QR, a timed promo, and a simple dashboard for $30/mo.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230A8BA8'/%3E%3Cpath d='M6 41c6 0 6-8 12-8s6 8 12 8 6-8 12-8 6 8 12 8' fill='none' stroke='%23FFC64B' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<style>
  :root{
    --accent:#0A8BA8; --deep:#0c4a58; --deep2:#0a7a94;
    --ink:#16202A; --bg:#F5F7F9; --card:#ffffff; --line:#E2E8ED;
    --muted:#56636e; --muted2:#7A8794; --sun:#F5B301; --sun-soft:#FFC64B;
    --tint:#E8F4F7; --shadow:0 1px 2px rgba(16,32,42,.04),0 8px 24px rgba(16,32,42,.06);
  }
  @media (prefers-color-scheme:dark){
    :root{--ink:#e9f1f4; --bg:#0e1519; --card:#15212a; --line:#26343d;
      --muted:#a4b4be; --muted2:#82929c; --tint:#123039; --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.35);}
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%}
  body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;
    background:var(--bg);color:var(--ink);line-height:1.55;-webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility}
  .wrap{max-width:640px;margin:0 auto;padding:0 20px}
  a{color:var(--accent)}
  .wm{font-weight:800;letter-spacing:-.01em}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;
    font-weight:700;font-size:16.5px;text-decoration:none;border-radius:12px;
    padding:15px 26px;background:var(--accent);color:#fff;border:none;cursor:pointer;
    box-shadow:0 6px 18px rgba(10,139,168,.28);transition:transform .18s cubic-bezier(.2,.8,.2,1),box-shadow .18s}
  .btn:hover{transform:translateY(-1px);box-shadow:0 10px 24px rgba(10,139,168,.34)}
  .btn:active{transform:translateY(0)}
  .btn .ar{transition:transform .18s cubic-bezier(.2,.8,.2,1)}
  .btn:hover .ar{transform:translateX(3px)}
  a:focus-visible,.btn:focus-visible{outline:3px solid var(--sun);outline-offset:3px}

  /* ---------- HERO ---------- */
  .hero{position:relative;overflow:hidden;color:#eef9fb;
    background:linear-gradient(158deg,var(--deep) 0%,var(--deep2) 100%);
    padding:26px 0 92px}
  .hero .sun{position:absolute;top:-70px;right:-40px;width:230px;height:230px;border-radius:50%;
    background:radial-gradient(circle,rgba(255,198,75,.30),rgba(255,198,75,0) 70%);pointer-events:none}
  .hero .wm{color:#fff;font-size:22px}
  .hero .wm i{font-style:normal;color:var(--sun-soft)}
  .eyebrow{display:inline-block;margin:22px 0 0;font-size:12.5px;font-weight:700;
    letter-spacing:.09em;text-transform:uppercase;color:#a9dce7}
  h1{font-size:clamp(30px,7.6vw,44px);line-height:1.08;letter-spacing:-.02em;font-weight:800;
    margin:10px 0 0;max-width:14ch}
  .lede{margin:16px 0 0;font-size:clamp(16px,4.4vw,18.5px);color:#cfe8ee;max-width:36ch}
  .priceline{display:flex;align-items:baseline;gap:10px;margin:26px 0 4px;flex-wrap:wrap}
  .priceline .amt{font-size:44px;font-weight:800;letter-spacing:-.02em;color:#fff;line-height:1}
  .priceline .per{font-size:16px;color:#bfe0e8}
  .priceline .flat{font-size:13px;font-weight:700;color:#0c333d;background:var(--sun-soft);
    padding:4px 10px;border-radius:999px;letter-spacing:.02em}
  .cta-row{margin-top:20px}
  .hero .btn{background:#fff;color:var(--deep);box-shadow:0 8px 22px rgba(3,26,32,.32)}
  .hero .btn:hover{box-shadow:0 12px 28px rgba(3,26,32,.38)}
  .reassure{margin-top:12px;font-size:13.5px;color:#a9dce7}
  .audience{margin-top:20px;font-size:13.5px;color:#bfe0e8;border-top:1px solid rgba(255,255,255,.14);
    padding-top:16px;max-width:40ch}
  .wave{position:absolute;left:0;right:0;bottom:-1px;width:100%;height:70px;display:block}
  .wave path{fill:var(--bg)}

  /* ---------- SECTIONS ---------- */
  section{padding:52px 0}
  .kicker{font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
  h2{font-size:clamp(23px,5.6vw,30px);line-height:1.14;letter-spacing:-.02em;font-weight:800;margin:8px 0 0}
  .sec-sub{margin:12px 0 0;font-size:16.5px;color:var(--muted);max-width:52ch}

  /* what you get */
  .grid{display:grid;grid-template-columns:1fr;gap:14px;margin-top:26px}
  @media(min-width:560px){.grid{grid-template-columns:1fr 1fr}}
  .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;
    box-shadow:var(--shadow);transition:transform .18s cubic-bezier(.2,.8,.2,1)}
  .card:hover{transform:translateY(-2px)}
  .ico{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;
    background:var(--tint);color:var(--accent);margin-bottom:14px}
  .ico svg{width:24px;height:24px}
  .card h3{font-size:17.5px;font-weight:700;letter-spacing:-.01em}
  .card p{margin-top:7px;font-size:14.8px;color:var(--muted);line-height:1.5}

  /* how it works */
  .how{background:var(--card);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .steps{display:grid;grid-template-columns:1fr;gap:22px;margin-top:28px}
  @media(min-width:620px){.steps{grid-template-columns:repeat(3,1fr);gap:18px}}
  .step{position:relative}
  .num{width:38px;height:38px;border-radius:50%;background:var(--accent);color:#fff;
    font-weight:800;font-size:17px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(10,139,168,.28)}
  .step h3{font-size:16.5px;font-weight:700;margin:14px 0 0;letter-spacing:-.01em}
  .step p{margin-top:6px;font-size:14.5px;color:var(--muted)}

  /* phone mockup */
  .show{text-align:center}
  .phone{position:relative;width:264px;max-width:82vw;margin:30px auto 0;aspect-ratio:264/540;
    background:#0b1418;border-radius:38px;padding:11px;
    box-shadow:0 2px 4px rgba(0,0,0,.2),0 26px 60px rgba(10,50,60,.32);border:1px solid #05242c}
  .phone .notch{position:absolute;top:11px;left:50%;transform:translateX(-50%);width:96px;height:22px;
    background:#0b1418;border-radius:0 0 14px 14px;z-index:5}
  .screen{position:relative;height:100%;border-radius:28px;overflow:hidden;
    background:linear-gradient(180deg,#0a7a94,#0a8ba8 40%,#eef4f6 40%)}
  .app-top{padding:20px 16px 12px;color:#fff}
  .app-top .aw{font-weight:800;font-size:14.5px}
  .app-top .aw i{font-style:normal;color:var(--sun-soft)}
  .app-top .loc{font-size:11px;color:#cdeef4;margin-top:3px}
  .cond{margin:8px 12px 0;background:#fff;border-radius:14px;padding:12px 13px;text-align:left;
    box-shadow:0 6px 16px rgba(9,40,48,.12)}
  .cond .b{font-weight:700;font-size:13.5px;color:var(--ink)}
  .cond .row{display:flex;align-items:center;gap:7px;margin-top:8px}
  .dotc{width:9px;height:9px;border-radius:50%}
  .cond .lbl{font-size:11.5px;color:#5a6b73}
  .cond .val{font-size:11.5px;font-weight:700;color:var(--ink);margin-left:auto}
  /* promo sheet */
  .promo{position:absolute;left:12px;right:12px;bottom:14px;background:#fff;border-radius:18px;
    padding:15px 15px 16px;text-align:left;box-shadow:0 -2px 8px rgba(9,40,48,.06),0 18px 34px rgba(9,40,48,.30);
    animation:rise .7s cubic-bezier(.2,.85,.25,1) .25s both}
  .promo .grip{width:34px;height:4px;border-radius:99px;background:#d7dee2;margin:0 auto 12px}
  .promo .live{display:inline-flex;align-items:center;gap:6px;font-size:10.5px;font-weight:700;
    letter-spacing:.05em;text-transform:uppercase;color:#0a7a2f}
  .promo .live .pd{width:7px;height:7px;border-radius:50%;background:#12b34a;
    box-shadow:0 0 0 0 rgba(18,179,74,.5);animation:pulse 2s infinite}
  .promo h4{font-size:16px;font-weight:800;color:var(--ink);margin:8px 0 0;letter-spacing:-.01em}
  .promo .deal{font-size:13.5px;color:#3f4c54;margin-top:3px}
  .promo .foot{display:flex;align-items:center;gap:10px;margin-top:13px}
  .promo .qr{width:44px;height:44px;flex:0 0 auto;border-radius:9px;background:var(--tint);
    display:flex;align-items:center;justify-content:center;color:var(--accent)}
  .promo .qr svg{width:28px;height:28px}
  .promo .note{font-size:11.5px;color:#66727a;line-height:1.4}
  .caption{margin:22px auto 0;font-size:13.5px;color:var(--muted2);max-width:38ch}

  /* price recap */
  .recap{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:28px 24px;
    box-shadow:var(--shadow);margin-top:8px;text-align:center}
  .recap .big{font-size:clamp(38px,10vw,54px);font-weight:800;letter-spacing:-.03em;line-height:1;color:var(--ink)}
  .recap .big span{color:var(--muted);font-size:.42em;font-weight:700;letter-spacing:0}
  .recap .tag{margin-top:8px;font-size:15px;color:var(--muted)}
  .checks{list-style:none;text-align:left;max-width:34ch;margin:22px auto 0;display:grid;gap:11px}
  .checks li{display:flex;gap:11px;font-size:15px;line-height:1.4}
  .checks .ck{flex:0 0 auto;width:22px;height:22px;border-radius:50%;background:var(--tint);
    color:var(--accent);display:flex;align-items:center;justify-content:center;margin-top:1px}
  .checks .ck svg{width:13px;height:13px}
  .recap .btn{margin-top:24px;width:100%;max-width:320px}

  /* coming soon */
  .soon{margin-top:20px;background:transparent;border:1px dashed var(--line);border-radius:16px;
    padding:18px 20px}
  .soon .lab{font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted2)}
  .soon p{font-size:14.5px;color:var(--muted);margin-top:6px;max-width:52ch}

  /* final cta */
  .final{background:linear-gradient(158deg,var(--deep) 0%,var(--deep2) 100%);color:#eef9fb;text-align:center;
    border-radius:22px;padding:40px 26px;margin:8px 0}
  .final h2{color:#fff}
  .final p{margin:12px auto 0;color:#cfe8ee;font-size:16px;max-width:34ch}
  .final .btn{margin-top:22px;background:#fff;color:var(--deep)}
  .final .re{margin-top:12px;font-size:13px;color:#a9dce7}

  /* footer */
  footer{padding:40px 0 56px;text-align:center;color:var(--muted2)}
  footer .wm{color:var(--ink);font-size:17px}
  footer .wm i{font-style:normal;color:var(--accent)}
  .disc{margin:14px auto 0;font-size:12.5px;color:var(--muted2);max-width:44ch;line-height:1.5}
  .contact{margin-top:14px;font-size:13.5px}

  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
  }
  @keyframes rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(18,179,74,.5)}70%{box-shadow:0 0 0 7px rgba(18,179,74,0)}100%{box-shadow:0 0 0 0 rgba(18,179,74,0)}}
</style></head>
<body>

<!-- ================= HERO ================= -->
<header class="hero">
  <div class="sun" aria-hidden="true"></div>
  <div class="wrap">
    <span class="wm">Ocean<i>Safe</i></span>
    <span class="eyebrow">Kauaʻi Town Ad</span>
    <h1>Get in front of visitors before they hit the beach.</h1>
    <p class="lede">List your business in the app Kauaʻi visitors open before the water, hand them a QR that opens the free beach-safety guide with you in it, and run a promo to the guests who scan it.</p>

    <div class="priceline">
      <span class="amt">$30</span>
      <span class="per">/ month</span>
      <span class="flat">Flat ad license</span>
    </div>
    <div class="cta-row">
      <a class="btn" href="/hotel-signup.html?type=townad">Get your Town Ad <span class="ar" aria-hidden="true">→</span></a>
    </div>
    <p class="reassure">Billed monthly through Square. Cancel anytime. No cut of your sales.</p>

    <p class="audience">Built for the restaurants, shops, activities, and services on the Town tab. Hotels get OceanSafe free, so this tier is for local businesses that want to be seen.</p>
  </div>
  <svg class="wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0,30 C240,72 480,72 720,44 C960,16 1200,16 1440,44 L1440,70 L0,70 Z"/></svg>
</header>

<!-- ================= WHAT YOU GET ================= -->
<section>
  <div class="wrap">
    <span class="kicker">What you get</span>
    <h2>Four things, for thirty dollars a month.</h2>
    <p class="sec-sub">Everything here is included. No add-ons, no per-sale cut.</p>

    <div class="grid">
      <div class="card">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6-5.3-6-10a6 6 0 0 1 12 0c0 4.7-6 10-6 10Z"/><circle cx="12" cy="11" r="2.2"/></svg></div>
        <h3>A spot in the Town tab</h3>
        <p>Your business shows up in the OceanSafe app that Kauaʻi visitors open before they head to the water.</p>
      </div>

      <div class="card">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.4"/><rect x="14" y="3" width="7" height="7" rx="1.4"/><rect x="3" y="14" width="7" height="7" rx="1.4"/><path d="M14 14h3v3M20.5 14v.02M14 20.5v.02M20.5 20.5v.02M17.2 17.2v.02"/></svg></div>
        <h3>A QR code that's yours</h3>
        <p>A digital asset you download once and use anywhere: print it for the counter, add it to receipts, drop it on a menu or flyer. A scan opens the free beach-safety guide with your business inside.</p>
      </div>

      <div class="card">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.2V12l3.1 2"/></svg></div>
        <h3>A timed promotion</h3>
        <p>Set an image or PDF to pop up for the guests who scan your QR, only during the hours and days you choose.</p>
      </div>

      <div class="card">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 8v6M9.5 10.5 12 8l2.5 2.5"/></svg></div>
        <h3>A simple dashboard</h3>
        <p>Upload your promo yourself and see a full-phone-screen preview of exactly how it looks before it runs.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= HOW GUESTS FIND YOU ================= -->
<section>
  <div class="wrap">
    <span class="kicker">How guests find you</span>
    <h2>The traffic is shared. Your QR is yours.</h2>
    <p class="sec-sub">Every visitor opens the same guide, so you join a pool you don't have to build. And your own QR is the lever you pull to bring guests in yourself.</p>

    <div class="grid">
      <div class="card">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 5.2a3.2 3.2 0 0 1 0 5.6M17.5 20a6.5 6.5 0 0 0-3-5.5"/></svg></div>
        <h3>Shared traffic</h3>
        <p>Everyone who opens OceanSafe browses one guide: the beaches, the map, the Town tab. Your listing sits in that shared pool, so a visitor already using the app can find you without ever walking past your door. As the guide grows, that pool grows with it, and you're already in it.</p>
      </div>

      <div class="card">
        <div class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.4"/><rect x="14" y="3" width="7" height="7" rx="1.4"/><rect x="3" y="14" width="7" height="7" rx="1.4"/><path d="M14 14h3v3M20.5 14v.02M14 20.5v.02M20.5 20.5v.02M17.2 17.2v.02"/></svg></div>
        <h3>What your QR does for you</h3>
        <p>Your QR is the part you control. Put it on a receipt or the counter, and every guest who scans it lands in the free guide with your promotion already popping on their screen. You hand them something useful on the way out, and turn your own walk-ins into repeat visits, tonight's reservation, or tomorrow's stop-back.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section class="how">
  <div class="wrap">
    <span class="kicker">How it works</span>
    <h2>Live in three steps.</h2>

    <div class="steps">
      <div class="step">
        <div class="num">1</div>
        <h3>Sign up and pay $30</h3>
        <p>Takes about two minutes. Billed monthly through Square.</p>
      </div>
      <div class="step">
        <div class="num">2</div>
        <h3>Get your QR and dashboard</h3>
        <p>Your listing, printable QR, and dashboard are set up automatically once you pay.</p>
      </div>
      <div class="step">
        <div class="num">3</div>
        <h3>Upload your promo</h3>
        <p>Add your image or PDF. Your promotion goes live within one business day.</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= SHOW (phone) ================= -->
<section class="show">
  <div class="wrap">
    <span class="kicker">What a guest sees</span>
    <h2>Your promo, on their phone.</h2>

    <div class="phone" role="img" aria-label="A phone showing the OceanSafe app with a sample promotion popping up: Poʻipū Beach Grill, happy hour 3 to 5pm.">
      <div class="notch" aria-hidden="true"></div>
      <div class="screen">
        <div class="app-top">
          <div class="aw">Ocean<i>Safe</i></div>
          <div class="loc">Poʻipū · today's conditions</div>
        </div>
        <div class="cond" aria-hidden="true">
          <div class="b">Poʻipū Beach</div>
          <div class="row"><span class="dotc" style="background:#f0a400"></span><span class="lbl">Surf</span><span class="val">Moderate</span></div>
          <div class="row"><span class="dotc" style="background:#12b34a"></span><span class="lbl">Wind</span><span class="val">Light</span></div>
          <div class="row"><span class="dotc" style="background:#12b34a"></span><span class="lbl">Water clarity</span><span class="val">Good</span></div>
        </div>
        <div class="promo">
          <div class="grip" aria-hidden="true"></div>
          <span class="live"><span class="pd" aria-hidden="true"></span>Running now</span>
          <h4>Poʻipū Beach Grill</h4>
          <div class="deal">Happy hour 3–5pm. Show this at the counter.</div>
          <div class="foot">
            <div class="qr" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.4"/><rect x="14" y="3" width="7" height="7" rx="1.4"/><rect x="3" y="14" width="7" height="7" rx="1.4"/><path d="M14 14h3v3M20.5 14v.02M14 20.5v.02M20.5 20.5v.02M17.2 17.2v.02"/></svg></div>
            <div class="note">Scanned your QR down the street a few minutes ago.</div>
          </div>
        </div>
      </div>
    </div>
    <p class="caption">A sample promo. It only shows to guests who scanned that business's QR, during the hours it is set to run.</p>
  </div>
</section>

<!-- ================= PRICE RECAP ================= -->
<section>
  <div class="wrap">
    <span class="kicker">The price</span>
    <h2>Thirty dollars a month. That's it.</h2>

    <div class="recap">
      <div class="big">$30<span> / month</span></div>
      <div class="tag">A flat ad license. We never take a cut of your sales.</div>
      <ul class="checks">
        <li><span class="ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17l9-10"/></svg></span>Your listing in the Town tab</li>
        <li><span class="ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17l9-10"/></svg></span>A printable QR code for your counter</li>
        <li><span class="ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17l9-10"/></svg></span>A timed promo for guests who scan it</li>
        <li><span class="ck" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5 10 17l9-10"/></svg></span>Your own dashboard with a live preview</li>
